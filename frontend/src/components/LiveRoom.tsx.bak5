import { useCallback, useEffect, useReducer, useRef, useState, type FormEvent, type ReactNode } from "react"
import { useQueryClient } from "@tanstack/react-query"
import { useTranslation } from "react-i18next"
import { DisconnectReason, Room, RoomEvent, Track, type Participant, type RemoteParticipant } from "livekit-client"
import { liveApi } from "../api/courses"
import { liveAdminApi } from "../api/live"
import { meetingApi } from "../api/meeting"
import { getErrorMessage } from "../lib/errors"
import { useLiveText } from "../lib/liveText"
import { canScreen, isUserCancel, mediaError } from "../lib/liveMedia"
import { useAuthStore } from "../stores/authStore"
import { toast } from "../stores/toastStore"
import Button from "./Button"
import Lobby, { type JoinOptions } from "./live/Lobby"
import { AudioSink, I, VideoTile, initials } from "./live/Tiles"

type Phase = "idle" | "connecting" | "connected" | "reconnecting" | "ended" | "error"
type AnyEmitter = { on(e: string, f: () => void): unknown }

interface Msg {
  id: number
  from: string
  text: string
  mine: boolean
}

interface Props {
  guest?: { invite: string; name: string }
  courseId: number
  live?: boolean
  studio?: boolean
}

// Evenements qui changent ce qu'on affiche : on relit alors l'etat de la salle
const REFRESH: RoomEvent[] = [
  RoomEvent.ParticipantConnected,
  RoomEvent.ParticipantDisconnected,
  RoomEvent.TrackSubscribed,
  RoomEvent.TrackUnsubscribed,
  RoomEvent.TrackPublished,
  RoomEvent.TrackUnpublished,
  RoomEvent.TrackMuted,
  RoomEvent.TrackUnmuted,
  RoomEvent.LocalTrackPublished,
  RoomEvent.LocalTrackUnpublished,
  RoomEvent.ActiveSpeakersChanged,
  RoomEvent.ParticipantPermissionsChanged,
  RoomEvent.ParticipantMetadataChanged,
  RoomEvent.ParticipantNameChanged,
]

const enc = (o: unknown) => new TextEncoder().encode(JSON.stringify(o))

function isHostMeta(p: Participant): boolean {
  try {
    return JSON.parse(p.metadata || "{}").role === "host"
  } catch {
    return false
  }
}

function Ctl({ icon, label, active, danger, onClick }: { icon: ReactNode; label: string; active?: boolean; danger?: boolean; onClick: () => void }) {
  const tone = danger
    ? "border-danger bg-danger text-white"
    : active
      ? "border-primary bg-primary/10 text-primary"
      : "border-line bg-surface text-muted hover:text-ink"
  return (
    <button
      type="button"
      onClick={onClick}
      aria-pressed={active}
      className={`flex min-h-[56px] min-w-[64px] flex-col items-center justify-center gap-1 rounded-xl border px-3 py-1.5 text-[11px] font-medium transition active:scale-95 ${tone}`}
    >
      {icon}
      {label}
    </button>
  )
}

export default function LiveRoom({ courseId, live, studio = false, guest }: Props) {
  const { t } = useTranslation()
  const L = useLiveText()
  const qc = useQueryClient()
  const user = useAuthStore((s) => s.user)
  const isAdminUser = !!user?.is_admin

  const [phase, setPhase] = useState<Phase>("idle")
  const [message, setMessage] = useState<string | null>(null)
  const [endReason, setEndReason] = useState<string | null>(null)
  const [isHost, setIsHost] = useState(false)
  const [audioBlocked, setAudioBlocked] = useState(false)
  const [mediaErr, setMediaErr] = useState<string | null>(null)
  const [msgs, setMsgs] = useState<Msg[]>([])
  const [draft, setDraft] = useState("")
  const [hands, setHands] = useState<Record<string, string>>({})
  const [handUp, setHandUp] = useState(false)
  const [tab, setTab] = useState<"people" | "chat">("people")
  const [unread, setUnread] = useState(0)
  const [showSettings, setShowSettings] = useState(false)
  const [devs, setDevs] = useState<{ mics: MediaDeviceInfo[]; cams: MediaDeviceInfo[] }>({ mics: [], cams: [] })
  const [, bump] = useReducer((n: number) => n + 1, 0)

  const room = useRef<Room | null>(null)
  const hostRef = useRef(false)
  const tabRef = useRef<"people" | "chat">("people")
  const chatBox = useRef<HTMLDivElement>(null)
  const stageBox = useRef<HTMLDivElement>(null)
  const seq = useRef(0)

  const leave = useCallback(() => {
    const r = room.current
    room.current = null
    r?.disconnect()
  }, [])

  // On quitte la salle en changeant de page
  useEffect(() => leave, [leave])

  useEffect(() => {
    tabRef.current = tab
  }, [tab])

  useEffect(() => {
    chatBox.current?.scrollTo({ top: chatBox.current.scrollHeight })
  }, [msgs, tab])

  function addMsg(from: string, text: string, mine: boolean) {
    seq.current += 1
    const m: Msg = { id: seq.current, from, text, mine }
    setMsgs((prev) => [...prev, m].slice(-100))
    if (!mine && tabRef.current !== "chat") setUnread((n) => n + 1)
  }

  function dropHand(identity: string) {
    setHands((h) => {
      const n = { ...h }
      delete n[identity]
      return n
    })
  }

  async function join(opts?: JoinOptions) {
    leave()
    setMessage(null)
    setEndReason(null)
    setMsgs([])
    setHands({})
    setHandUp(false)
    setAudioBlocked(false)
    setMediaErr(null)
    setUnread(0)
    setShowSettings(false)
    setPhase("connecting")

    const r = new Room({
      adaptiveStream: true,
      dynacast: true,
      audioCaptureDefaults: opts?.micId ? { deviceId: opts.micId } : undefined,
      videoCaptureDefaults: opts?.camId ? { deviceId: opts.camId } : undefined,
    })
    room.current = r

    const emitter = r as unknown as AnyEmitter
    REFRESH.forEach((ev) => emitter.on(ev, bump))

    r.on(RoomEvent.ParticipantDisconnected, (p: RemoteParticipant) => dropHand(p.identity))
    r.on(RoomEvent.ParticipantPermissionsChanged, (_prev, p) => {
      if (p.identity !== r.localParticipant.identity) return
      if (r.localParticipant.permissions?.canPublish) {
        setHandUp(false)
        toast.info(L.granted)
      } else {
        toast.info(L.revoked)
      }
    })
    r.on(RoomEvent.DataReceived, (payload: Uint8Array, p?: RemoteParticipant) => {
      try {
        const d = JSON.parse(new TextDecoder().decode(payload)) as { t?: string; m?: string; v?: boolean }
        const who = p?.name || p?.identity || "?"
        if (d.t === "chat" && typeof d.m === "string") {
          addMsg(who, d.m.slice(0, 500), false)
        } else if (d.t === "hand" && p) {
          if (d.v) {
            setHands((h) => ({ ...h, [p.identity]: who }))
            if (hostRef.current) toast.info(`${who} ${L.wantsToSpeak}`)
          } else {
            dropHand(p.identity)
          }
        }
      } catch {
        // message illisible : ignore
      }
    })
    r.on(RoomEvent.MediaDevicesError, (e: Error) => setMediaErr(mediaError(e, L)))
    r.on(RoomEvent.AudioPlaybackStatusChanged, () => setAudioBlocked(!r.canPlaybackAudio))
    r.on(RoomEvent.Reconnecting, () => setPhase("reconnecting"))
    r.on(RoomEvent.Reconnected, () => setPhase("connected"))
    r.on(RoomEvent.Disconnected, (reason?: DisconnectReason) => {
      if (room.current === r) {
        room.current = null
        setEndReason(
          reason === DisconnectReason.PARTICIPANT_REMOVED ? L.removed : reason === DisconnectReason.DUPLICATE_IDENTITY ? L.duplicate : null,
        )
        setPhase("ended")
      }
    })

    try {
      const { data } = guest ? await meetingApi.guestToken(guest.invite, guest.name) : await liveApi.token(courseId)
      const info = data.data as unknown as { url: string; token: string; can_publish?: boolean; is_host?: boolean }
      hostRef.current = !!info.is_host
      setIsHost(!!info.can_publish)
      await r.connect(info.url, info.token)
      if (room.current !== r) return // l'utilisateur a quitte entre-temps
      await r.startAudio().catch(() => setAudioBlocked(true))
      if (info.can_publish && opts) {
        try {
          if (opts.mic) await r.localParticipant.setMicrophoneEnabled(true)
          if (opts.cam) await r.localParticipant.setCameraEnabled(true)
        } catch (e) {
          setMediaErr(mediaError(e, L))
        }
      }
      if (room.current !== r) return
      setPhase("connected")
    } catch (e) {
      r.disconnect()
      if (room.current === r) room.current = null
      setMessage(getErrorMessage(e))
      setPhase("error")
    }
  }

  async function toggle(kind: "mic" | "cam" | "screen") {
    const lp = room.current?.localParticipant
    if (!lp) return
    setMediaErr(null)
    try {
      if (kind === "mic") await lp.setMicrophoneEnabled(!lp.isMicrophoneEnabled)
      else if (kind === "cam") await lp.setCameraEnabled(!lp.isCameraEnabled)
      else await lp.setScreenShareEnabled(!lp.isScreenShareEnabled, { audio: true })
    } catch (e) {
      if (!(kind === "screen" && isUserCancel(e))) setMediaErr(mediaError(e, L))
    }
    bump()
  }

  async function toggleHand() {
    const r = room.current
    if (!r) return
    const v = !handUp
    setHandUp(v)
    try {
      await r.localParticipant.publishData(enc({ t: "hand", v }), { reliable: true })
    } catch {
      setHandUp(!v)
    }
  }

  async function sendChat(e: FormEvent) {
    e.preventDefault()
    const text = draft.trim().slice(0, 500)
    const r = room.current
    if (!text || !r) return
    setDraft("")
    try {
      await r.localParticipant.publishData(enc({ t: "chat", m: text }), { reliable: true })
      addMsg(r.localParticipant.name || L.me, text, true)
    } catch {
      setDraft(text)
    }
  }

  async function permit(identity: string, allow: boolean) {
    try {
      await liveAdminApi.permit(courseId, identity, allow)
      dropHand(identity)
      window.setTimeout(bump, 600)
    } catch (e) {
      toast.error(getErrorMessage(e))
    }
  }

  async function kick(identity: string) {
    if (!window.confirm(L.kickConfirm)) return
    try {
      await liveAdminApi.kick(courseId, identity)
    } catch (e) {
      toast.error(getErrorMessage(e))
    }
  }

  async function endAll() {
    if (!window.confirm(L.stopConfirm)) return
    try {
      await liveAdminApi.stop(courseId)
      void qc.invalidateQueries({ queryKey: ["live-status"] })
      leave()
      setEndReason(L.endedByYou)
      setPhase("ended")
    } catch (e) {
      toast.error(getErrorMessage(e))
    }
  }

  async function toggleSettings() {
    const next = !showSettings
    setShowSettings(next)
    if (!next) return
    try {
      const [mics, cams] = await Promise.all([Room.getLocalDevices("audioinput", false), Room.getLocalDevices("videoinput", false)])
      setDevs({ mics, cams })
    } catch {
      // liste indisponible
    }
  }

  async function switchDevice(kind: "audioinput" | "videoinput", id: string) {
    try {
      await room.current?.switchActiveDevice(kind, id)
    } catch (e) {
      setMediaErr(mediaError(e, L))
    }
  }

  function fullscreen() {
    void stageBox.current?.requestFullscreen?.().catch(() => undefined)
  }

  const active = phase === "connected" || phase === "reconnecting"
  const title = studio ? L.studioTitle : L.title

  const r = room.current
  const lp = r?.localParticipant
  const remote = r ? Array.from(r.remoteParticipants.values()) : []
  const all: Participant[] = lp ? [lp, ...remote] : remote
  const hostOf = (p: Participant) => isHostMeta(p) || (!!lp && p.identity === lp.identity && isHost)
  const canPublish = !!lp?.permissions?.canPublish
  const remoteShare = all.find((p) => p.isScreenShareEnabled && (!lp || p.identity !== lp.identity))
  const sharingMe = !!lp && lp.isScreenShareEnabled
  const presenters = all.filter((p) => hostOf(p) || p.isCameraEnabled || p.isMicrophoneEnabled)
  const people = [...all].sort(
    (a, b) =>
      Number(hostOf(b)) - Number(hostOf(a)) ||
      Number(!!hands[b.identity]) - Number(!!hands[a.identity]) ||
      (a.name || "").localeCompare(b.name || ""),
  )
  const handCount = Object.keys(hands).length

  const tabCls = (on: boolean) =>
    `flex-1 border-b-2 px-3 py-2 text-sm font-semibold ${on ? "border-primary text-primary" : "border-transparent text-muted"}`

  return (
    <section className="mb-6 rounded-card border border-line bg-surface p-4 shadow-card" aria-label={title}>
      <div className="mb-3 flex items-center justify-between gap-3">
        <h2 className="flex items-center gap-2 font-semibold">
          {title}
          {live && (
            <span className="inline-flex items-center gap-1.5 rounded-full bg-danger px-2 py-0.5 text-[10px] font-bold uppercase text-white">
              <span className="h-1.5 w-1.5 animate-pulse rounded-full bg-white" />
              {L.badge}
            </span>
          )}
        </h2>
      </div>

      {phase === "idle" &&
        (live === false ? (
          <p role="status" className="py-4 text-center text-sm text-muted">{L.none}</p>
        ) : isAdminUser ? (
          <Lobby busy={false} onJoin={(o) => void join(o)} />
        ) : (
          <div>
            <p className="mb-3 text-sm text-muted">{L.intro}</p>
            <Button onClick={() => void join()}>{L.joinBtn}</Button>
          </div>
        ))}

      {phase === "connecting" && <p role="status" className="py-6 text-center text-sm text-muted">{L.connecting}</p>}

      {phase === "error" && (
        <div role="alert" className="rounded-lg bg-danger/10 px-3 py-3 text-sm text-danger">
          <p>{message}</p>
          <Button className="mt-3" size="sm" variant="secondary" onClick={() => (isAdminUser ? setPhase("idle") : void join())}>
            {t("states.retry")}
          </Button>
        </div>
      )}

      {phase === "ended" && (
        <div role="status" className="py-4 text-center text-sm text-muted">
          <p>{endReason ?? L.ended}</p>
          {live !== false && (
            <Button className="mt-3" size="sm" onClick={() => (isAdminUser ? setPhase("idle") : void join())}>
              {L.rejoin}
            </Button>
          )}
        </div>
      )}

      {active && r && lp && (
        <div className="grid gap-4 lg:grid-cols-[minmax(0,1fr)_20rem]">
          <div>
            <div ref={stageBox} className="relative overflow-hidden rounded-card bg-black p-1.5">
              {sharingMe && (
                <p className="mb-1.5 rounded-md bg-danger px-3 py-1 text-center text-xs font-semibold text-white">{L.youShare}</p>
              )}
              {remoteShare ? (
                <div className="space-y-1.5">
                  <VideoTile p={remoteShare} source={Track.Source.ScreenShare} label={`${L.screenOf} ${remoteShare.name || remoteShare.identity}`} />
                  {presenters.length > 0 && (
                    <div className="flex gap-1.5 overflow-x-auto">
                      {presenters.map((p) => (
                        <div key={p.identity} className="w-32 shrink-0 sm:w-40">
                          <VideoTile p={p} host={hostOf(p)} me={p.identity === lp.identity} />
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              ) : presenters.length > 0 ? (
                <div className={`grid gap-1.5 ${presenters.length === 1 ? "grid-cols-1" : presenters.length <= 4 ? "grid-cols-2" : "grid-cols-2 lg:grid-cols-3"}`}>
                  {presenters.map((p) => (
                    <VideoTile key={p.identity} p={p} host={hostOf(p)} me={p.identity === lp.identity} />
                  ))}
                </div>
              ) : (
                <p role="status" className="grid aspect-video place-items-center px-4 text-center text-sm text-white">{L.waiting}</p>
              )}
              {phase === "reconnecting" && (
                <p role="status" className="absolute inset-x-0 top-0 bg-ink/80 px-3 py-1.5 text-center text-xs text-white">{L.reconnecting}</p>
              )}
              {remote.map((p) => (
                <AudioSink key={`${p.identity}-mic`} p={p} source={Track.Source.Microphone} />
              ))}
              {remote.map((p) => (
                <AudioSink key={`${p.identity}-sa`} p={p} source={Track.Source.ScreenShareAudio} />
              ))}
            </div>

            {mediaErr && (
              <div role="alert" className="mt-3 flex items-start justify-between gap-3 rounded-lg bg-danger/10 px-3 py-2 text-sm text-danger">
                <p>{mediaErr}</p>
                <button type="button" className="shrink-0 font-semibold" onClick={() => setMediaErr(null)}>{L.dismiss}</button>
              </div>
            )}
            {!canScreen && canPublish && <p className="mt-2 text-center text-xs text-muted">{L.errScreenUnsupported}</p>}
            {handUp && !canPublish && <p role="status" className="mt-3 text-center text-sm text-muted">{L.handRaised}</p>}

            <div className="mt-3 flex flex-wrap items-center justify-center gap-2">
              {canPublish && (
                <>
                  <Ctl active={lp.isMicrophoneEnabled} icon={lp.isMicrophoneEnabled ? I.mic : I.micOff} label={L.microphone} onClick={() => void toggle("mic")} />
                  <Ctl active={lp.isCameraEnabled} icon={lp.isCameraEnabled ? I.cam : I.camOff} label={L.camera} onClick={() => void toggle("cam")} />
                  {canScreen && (
                    <Ctl active={lp.isScreenShareEnabled} icon={I.screen} label={lp.isScreenShareEnabled ? L.stopShare : L.screenShare} onClick={() => void toggle("screen")} />
                  )}
                  <Ctl active={showSettings} icon={I.gear} label={L.settings} onClick={() => void toggleSettings()} />
                </>
              )}
              {!canPublish && (
                <Ctl active={handUp} icon={<span className="text-lg leading-5" aria-hidden="true">&#9995;</span>} label={handUp ? L.lowerHand : L.raiseHand} onClick={() => void toggleHand()} />
              )}
              <Ctl icon={I.expand} label={L.fullscreen} onClick={fullscreen} />
              {audioBlocked && <Ctl active icon={I.mic} label={L.enableAudio} onClick={() => void r.startAudio().then(() => setAudioBlocked(false))} />}
              {isHost && <Ctl danger icon={<span className="text-sm font-bold">&#9632;</span>} label={L.endAll} onClick={() => void endAll()} />}
              <Ctl icon={<span className="text-sm font-bold">&#10005;</span>} label={L.leave} onClick={() => { leave(); setPhase("idle") }} />
            </div>

            {showSettings && canPublish && (
              <div className="mt-3 grid gap-3 rounded-card border border-line p-3 sm:grid-cols-2">
                <div>
                  <label htmlFor="set-mic" className="block text-xs font-semibold">{L.microphone}</label>
                  <select
                    id="set-mic"
                    defaultValue={r.getActiveDevice("audioinput") ?? ""}
                    onChange={(e) => void switchDevice("audioinput", e.target.value)}
                    className="mt-1 min-h-[44px] w-full rounded-lg border border-line bg-surface px-2 text-sm"
                  >
                    {devs.mics.map((d, i) => (
                      <option key={d.deviceId || i} value={d.deviceId}>{d.label || `${L.microphone} ${i + 1}`}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label htmlFor="set-cam" className="block text-xs font-semibold">{L.camera}</label>
                  <select
                    id="set-cam"
                    defaultValue={r.getActiveDevice("videoinput") ?? ""}
                    onChange={(e) => void switchDevice("videoinput", e.target.value)}
                    className="mt-1 min-h-[44px] w-full rounded-lg border border-line bg-surface px-2 text-sm"
                  >
                    {devs.cams.map((d, i) => (
                      <option key={d.deviceId || i} value={d.deviceId}>{d.label || `${L.camera} ${i + 1}`}</option>
                    ))}
                  </select>
                </div>
              </div>
            )}
          </div>

          <aside className="rounded-card border border-line">
            <div role="tablist" className="flex border-b border-line">
              <button type="button" role="tab" aria-selected={tab === "people"} className={tabCls(tab === "people")} onClick={() => setTab("people")}>
                {L.people} ({all.length})
                {isHost && handCount > 0 && <span className="ml-1 rounded-full bg-primary px-1.5 text-[10px] text-white">{handCount}</span>}
              </button>
              <button type="button" role="tab" aria-selected={tab === "chat"} className={tabCls(tab === "chat")} onClick={() => { setTab("chat"); setUnread(0) }}>
                {L.chatTitle}
                {unread > 0 && <span className="ml-1 rounded-full bg-danger px-1.5 text-[10px] text-white">{unread}</span>}
              </button>
            </div>

            {tab === "people" ? (
              <ul className="max-h-[22rem] divide-y divide-line overflow-y-auto px-3">
                {people.map((p) => {
                  const me = p.identity === lp.identity
                  const name = p.name || p.identity
                  const speaker = !!p.permissions?.canPublish
                  return (
                    <li key={p.identity} className="flex items-center gap-2 py-2">
                      <span className="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-primary/10 text-xs font-bold text-primary">{initials(name)}</span>
                      <div className="min-w-0 flex-1">
                        <p className="truncate text-sm font-medium">{name}{me ? ` (${L.you})` : ""}</p>
                        <p className="truncate text-[11px] text-muted">
                          {hostOf(p) ? L.host : speaker ? L.canSpeak : ""}
                          {hands[p.identity] ? ` \u270B ${L.wantsToSpeak}` : ""}
                        </p>
                      </div>
                      <span className={p.isMicrophoneEnabled ? "text-primary" : "text-muted"}>{p.isMicrophoneEnabled ? I.micSm : I.micOffSm}</span>
                      {isHost && !me && !hostOf(p) && (
                        <div className="flex shrink-0 gap-1">
                          <button type="button" onClick={() => void permit(p.identity, !speaker)} className="rounded-md border border-line px-2 py-1 text-[11px] font-semibold hover:bg-page">
                            {speaker ? L.revoke : L.allow}
                          </button>
                          <button type="button" onClick={() => void kick(p.identity)} className="rounded-md border border-danger/40 px-2 py-1 text-[11px] font-semibold text-danger hover:bg-danger/5">
                            {L.kick}
                          </button>
                        </div>
                      )}
                    </li>
                  )
                })}
              </ul>
            ) : (
              <div>
                <div ref={chatBox} className="max-h-[18rem] min-h-[8rem] space-y-2 overflow-y-auto px-3 py-2" aria-live="polite">
                  {msgs.length === 0 && <p className="py-2 text-center text-xs text-muted">{L.chatEmpty}</p>}
                  {msgs.map((m) => (
                    <div key={m.id} className={`flex flex-col ${m.mine ? "items-end" : "items-start"}`}>
                      <span className="text-[11px] text-muted">{m.from}</span>
                      <span className={`max-w-[85%] break-words rounded-2xl px-3 py-1.5 text-sm ${m.mine ? "bg-primary text-white" : "bg-page"}`}>{m.text}</span>
                    </div>
                  ))}
                </div>
                <form onSubmit={(e) => void sendChat(e)} className="flex gap-2 border-t border-line p-2">
                  <input
                    value={draft}
                    onChange={(e) => setDraft(e.target.value)}
                    maxLength={500}
                    placeholder={L.chatPlaceholder}
                    aria-label={L.chatPlaceholder}
                    className="min-h-[44px] min-w-0 flex-1 rounded-lg border border-line bg-surface px-3 text-sm"
                  />
                  <Button type="submit" size="sm" disabled={draft.trim() === ""}>{L.chatSend}</Button>
                </form>
              </div>
            )}
          </aside>
        </div>
      )}
    </section>
  )
}