import { useCallback, useEffect, useRef, useState, type FormEvent } from "react"
import { useTranslation } from "react-i18next"
import { Room, RoomEvent, Track, type LocalTrackPublication, type RemoteParticipant, type RemoteTrack } from "livekit-client"
import { liveApi } from "../api/courses"
import { getErrorMessage } from "../lib/errors"
import { useLiveText } from "../lib/liveText"
import Button from "./Button"

type Phase = "idle" | "connecting" | "connected" | "reconnecting" | "ended" | "error"

interface Msg {
  id: number
  from: string
  text: string
  mine: boolean
}

interface Props {
  courseId: number
  live?: boolean
  studio?: boolean
}

export default function LiveRoom({ courseId, live, studio = false }: Props) {
  const { t } = useTranslation()
  const L = useLiveText()
  const [phase, setPhase] = useState<Phase>("idle")
  const [message, setMessage] = useState<string | null>(null)
  const [hasVideo, setHasVideo] = useState(false)
  const [audioBlocked, setAudioBlocked] = useState(false)
  const [msgs, setMsgs] = useState<Msg[]>([])
  const [draft, setDraft] = useState("")
  const stage = useRef<HTMLDivElement>(null)
  const room = useRef<Room | null>(null)
  const chatBox = useRef<HTMLDivElement>(null)
  const seq = useRef(0)

  const leave = useCallback(() => {
    room.current?.disconnect()
    room.current = null
  }, [])

  // On quitte la salle en changeant de page
  useEffect(() => leave, [leave])

  useEffect(() => {
    chatBox.current?.scrollTo({ top: chatBox.current.scrollHeight })
  }, [msgs])

  function addMsg(from: string, text: string, mine: boolean) {
    seq.current += 1
    const m: Msg = { id: seq.current, from, text, mine }
    setMsgs((prev) => [...prev, m].slice(-100))
  }

  async function join() {
    leave()
    setMessage(null)
    setHasVideo(false)
    setAudioBlocked(false)
    setMsgs([])
    setPhase("connecting")

    const r = new Room({ adaptiveStream: true, dynacast: true })
    room.current = r

    r.on(RoomEvent.TrackSubscribed, (track: RemoteTrack) => {
      if (track.kind === Track.Kind.Video || track.kind === Track.Kind.Audio) {
        const el = track.attach()
        if (track.kind === Track.Kind.Video) {
          el.className = "h-full w-full object-contain"
          setHasVideo(true)
        }
        stage.current?.appendChild(el)
      }
    })
    r.on(RoomEvent.TrackUnsubscribed, (track: RemoteTrack) => {
      track.detach().forEach((el) => el.remove())
      if (track.kind === Track.Kind.Video) setHasVideo(false)
    })
    // Formateur : apercu local de la camera (jamais le micro, pour eviter l'echo)
    r.on(RoomEvent.LocalTrackPublished, (pub: LocalTrackPublication) => {
      if (pub.track && pub.track.kind === Track.Kind.Video) {
        const el = pub.track.attach()
        el.className = "h-full w-full object-contain"
        setHasVideo(true)
        stage.current?.appendChild(el)
      }
    })
    r.on(RoomEvent.LocalTrackUnpublished, (pub: LocalTrackPublication) => {
      pub.track?.detach().forEach((el) => el.remove())
      if (pub.kind === Track.Kind.Video) setHasVideo(false)
    })
    r.on(RoomEvent.DataReceived, (payload: Uint8Array, p?: RemoteParticipant) => {
      try {
        const d = JSON.parse(new TextDecoder().decode(payload)) as { t?: string; m?: string }
        if (d.t !== "chat" || typeof d.m !== "string") return
        addMsg(p?.name || p?.identity || "?", d.m.slice(0, 500), false)
      } catch {
        // message illisible : ignore
      }
    })
    r.on(RoomEvent.AudioPlaybackStatusChanged, () => setAudioBlocked(!r.canPlaybackAudio))
    r.on(RoomEvent.Reconnecting, () => setPhase("reconnecting"))
    r.on(RoomEvent.Reconnected, () => setPhase("connected"))
    r.on(RoomEvent.Disconnected, () => {
      if (room.current === r) {
        room.current = null
        setPhase("ended")
      }
    })

    try {
      const { data } = await liveApi.token(courseId)
      const info = data.data as unknown as { url: string; token: string; can_publish?: boolean }
      await r.connect(info.url, info.token)
      if (room.current !== r) return // l'utilisateur a quitte entre-temps
      if (info.can_publish) await r.localParticipant.enableCameraAndMicrophone()
      else await r.startAudio().catch(() => setAudioBlocked(true))
      if (room.current !== r) return
      setPhase("connected")
    } catch (e) {
      r.disconnect()
      if (room.current === r) room.current = null
      setMessage(getErrorMessage(e))
      setPhase("error")
    }
  }

  async function sendChat(e: FormEvent) {
    e.preventDefault()
    const text = draft.trim().slice(0, 500)
    const r = room.current
    if (!text || !r) return
    setDraft("")
    try {
      await r.localParticipant.publishData(new TextEncoder().encode(JSON.stringify({ t: "chat", m: text })), { reliable: true })
      addMsg(r.localParticipant.name || L.me, text, true)
    } catch {
      setDraft(text)
    }
  }

  const active = phase === "connected" || phase === "reconnecting"
  const title = studio ? L.studioTitle : L.title

  return (
    <section className="mb-6 rounded-card border border-line bg-surface p-4 shadow-card" aria-label={title}>
      <div className="mb-3 flex items-center justify-between gap-3">
        <h2 className="flex items-center gap-2 font-semibold">
          {title}
          {live && (
            <span className="inline-flex items-center gap-1.5 rounded-full bg-danger px-2 py-0.5 text-[10px] font-bold uppercase text-white">
              <span className="h-1.5 w-1.5 animate-pulse rounded-full bg-white" />
              {L.badge}
            </span>
          )}
        </h2>
        {active && (
          <Button size="sm" variant="secondary" onClick={() => { leave(); setPhase("idle") }}>
            {L.leave}
          </Button>
        )}
      </div>

      {phase === "idle" &&
        (live === false ? (
          <p role="status" className="py-4 text-center text-sm text-muted">{L.none}</p>
        ) : (
          <div>
            <p className="mb-3 text-sm text-muted">{studio ? L.studioIntro : L.intro}</p>
            <Button onClick={() => void join()}>{studio ? L.studioBtn : L.joinBtn}</Button>
          </div>
        ))}

      {phase === "connecting" && (
        <p role="status" className="py-6 text-center text-sm text-muted">{L.connecting}</p>
      )}

      {phase === "error" && (
        <div role="alert" className="rounded-lg bg-danger/10 px-3 py-3 text-sm text-danger">
          <p>{message}</p>
          <Button className="mt-3" size="sm" variant="secondary" onClick={() => void join()}>
            {t("states.retry")}
          </Button>
        </div>
      )}

      {phase === "ended" && (
        <div role="status" className="py-4 text-center text-sm text-muted">
          <p>{L.ended}</p>
          {live !== false && (
            <Button className="mt-3" size="sm" onClick={() => void join()}>
              {L.rejoin}
            </Button>
          )}
        </div>
      )}

      {active && (
        <>
          <div className="relative aspect-video w-full overflow-hidden rounded-card bg-black">
            <div ref={stage} className="absolute inset-0" />
            {!hasVideo && (
              <p role="status" className="absolute inset-0 grid place-items-center px-4 text-center text-sm text-white">
                {studio ? L.cameraStarting : L.waiting}
              </p>
            )}
            {phase === "reconnecting" && (
              <p role="status" className="absolute inset-x-0 top-0 bg-ink/80 px-3 py-1.5 text-center text-xs text-white">
                {L.reconnecting}
              </p>
            )}
          </div>
          {audioBlocked && (
            <Button className="mt-3" size="sm" onClick={() => void room.current?.startAudio().then(() => setAudioBlocked(false))}>
              {L.enableAudio}
            </Button>
          )}

          <div className="mt-4 rounded-card border border-line">
            <p className="border-b border-line px-3 py-2 text-sm font-semibold">{L.chatTitle}</p>
            <div ref={chatBox} className="max-h-56 min-h-[6rem] space-y-2 overflow-y-auto px-3 py-2" aria-live="polite">
              {msgs.length === 0 && <p className="py-2 text-center text-xs text-muted">{L.chatEmpty}</p>}
              {msgs.map((m) => (
                <div key={m.id} className={`flex flex-col ${m.mine ? "items-end" : "items-start"}`}>
                  <span className="text-[11px] text-muted">{m.from}</span>
                  <span className={`max-w-[85%] break-words rounded-2xl px-3 py-1.5 text-sm ${m.mine ? "bg-primary text-white" : "bg-page"}`}>
                    {m.text}
                  </span>
                </div>
              ))}
            </div>
            <form onSubmit={(e) => void sendChat(e)} className="flex gap-2 border-t border-line p-2">
              <input
                value={draft}
                onChange={(e) => setDraft(e.target.value)}
                maxLength={500}
                placeholder={L.chatPlaceholder}
                aria-label={L.chatPlaceholder}
                className="min-h-[44px] min-w-0 flex-1 rounded-lg border border-line bg-surface px-3 text-sm"
              />
              <Button type="submit" size="sm" disabled={draft.trim() === ""}>{L.chatSend}</Button>
            </form>
          </div>
        </>
      )}
    </section>
  )
}