<?php

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use App\Models\Course;
use App\Services\ActivityLogger;
use App\Services\LiveKitRoomAdmin;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;

class LiveController extends Controller
{
    public function start(Request $request, int $course, ActivityLogger $activity): JsonResponse
    {
        $model = Course::query()->findOrFail($course);
        $room = (string) $model->livekit_room;
        if ($room === '') {
            $room = 'course-'.$model->id;
        }

        $model->forceFill(['livekit_room' => $room, 'is_live' => true, 'live_started_at' => now()])->save();
        $activity->log($request->user(), 'live.started', $model, ['course_id' => $model->id]);

        return response()->json(['data' => ['course_id' => $model->id, 'is_live' => true]]);
    }

    public function stop(Request $request, int $course, ActivityLogger $activity, LiveKitRoomAdmin $rooms): JsonResponse
    {
        $model = Course::query()->findOrFail($course);
        $model->forceFill(['is_live' => false, 'live_started_at' => null])->save();

        if ((string) $model->livekit_room !== '') {
            $rooms->end((string) $model->livekit_room);
        }

        $activity->log($request->user(), 'live.stopped', $model, ['course_id' => $model->id]);

        return response()->json(['data' => ['course_id' => $model->id, 'is_live' => false]]);
    }

    public function permit(Request $request, int $course, ActivityLogger $activity, LiveKitRoomAdmin $rooms): JsonResponse
    {
        $data = $request->validate([
            'identity' => ['required', 'string', 'regex:/^(user|guest)-[a-z0-9]+$/'],
            'allow' => ['required', 'boolean'],
        ]);

        $model = Course::query()->findOrFail($course);
        $room = (string) $model->livekit_room;
        if ($room === '') {
            return response()->json(['message' => __('live.not_started')], 422);
        }

        if (! $rooms->permit($room, $data['identity'], (bool) $data['allow'])) {
            return response()->json(['message' => __('live.server_unavailable')], 502);
        }

        $activity->log($request->user(), $data['allow'] ? 'live.speak_granted' : 'live.speak_revoked', $model, ['identity' => $data['identity']]);

        return response()->json(['data' => ['identity' => $data['identity'], 'allow' => (bool) $data['allow']]]);
    }

    public function kick(Request $request, int $course, ActivityLogger $activity, LiveKitRoomAdmin $rooms): JsonResponse
    {
        $data = $request->validate([
            'identity' => ['required', 'string', 'regex:/^(user|guest)-[a-z0-9]+$/'],
        ]);

        $model = Course::query()->findOrFail($course);
        $room = (string) $model->livekit_room;
        if ($room === '') {
            return response()->json(['message' => __('live.not_started')], 422);
        }

        if (! $rooms->remove($room, $data['identity'])) {
            return response()->json(['message' => __('live.server_unavailable')], 502);
        }

        $activity->log($request->user(), 'live.participant_removed', $model, ['identity' => $data['identity']]);

        return response()->json(['data' => ['identity' => $data['identity']]]);
    }
}